# Default: auto-detect, normalize on commit.
* text=auto

# Files that MUST keep LF endings on every platform (would break otherwise).
*.sh         text eol=lf
*.bash       text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.go         text eol=lf
*.py         text eol=lf
*.service    text eol=lf
*.conf       text eol=lf
debian/*     text eol=lf
.gitattributes text eol=lf
.gitignore   text eol=lf

# Binary explicit (don't try to diff/merge as text).
*.png        binary
*.jpg        binary
*.deb        binary
*.iso        binary
*.gz         binary
*.zip        binary
*.tar        binary
