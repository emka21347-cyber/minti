<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    MINTI runtime adapter — system-wide launchd daemon (Dist D2).

    Clone of the peer-reviewed com.minti.cland.plist (M5-C) with the
    runtime's paths. Loopback-only daemon (127.0.0.1:7780 per its
    runtime.yaml); no inbound LAN exposure, so no Application Firewall
    prompt is expected for it.

    The per-user variant is generated by install-minti.sh (UserName
    removed via plutil, paths rewritten under $HOME).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minti.runtime</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/minti-runtime</string>
        <string>--config</string>
        <string>/Library/Application Support/MINTI/runtime/runtime.yaml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>UserName</key>
    <string>_minti</string>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/MINTI/runtime</string>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/minti/runtime.out.log</string>

    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/minti/runtime.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Library/Application Support/MINTI/runtime</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
