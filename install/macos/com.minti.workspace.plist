<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    MINTI Clan Workspace — system-wide launchd daemon (Dist D2).

    Clone of the peer-reviewed com.minti.cland.plist (M5-C). Loopback
    only (127.0.0.1:8088) until PIN/bearer auth lands.

    Three EnvironmentVariables are LOAD-BEARING for the live mesh view
    (the workspace shells the minti-cland CLI with JSON output per request):
      - MINTI_CONFIG points the CLI straight at the real cland config
        (cland's DefaultConfigPath honors this env first) — the robust,
        account-independent fix. Without it the non-root _minti CLI reports
        the Clan as "unconfigured" even while the daemon is joined.
      - PATH must include /usr/local/bin — launchd daemons default to
        /usr/bin:/bin:/usr/sbin:/sbin and exec.LookPath would miss the
        CLI entirely (demo data forever).
      - HOME=/ is the legacy fallback (kept one release): it makes the CLI's
        non-root default config path resolve to a symlink the installer
        stages. MINTI_CONFIG supersedes it.

    The per-user variant is generated by install-minti.sh (UserName
    removed via plutil, paths + PATH rewritten under $HOME, HOME left
    untouched — the user's real HOME already resolves correctly).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minti.workspace</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/minti-workspace</string>
        <string>-listen</string>
        <string>127.0.0.1:8088</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>UserName</key>
    <string>_minti</string>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/MINTI/workspace</string>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/minti/workspace.out.log</string>

    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/minti/workspace.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MINTI_CONFIG</key>
        <string>/Library/Application Support/MINTI/cland/cland.yaml</string>
        <key>HOME</key>
        <string>/</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
