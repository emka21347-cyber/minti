/* minti.script — Plymouth script-plugin boot animation (the ▚ quadrant mark).
 *
 * Animation sequence (t = boot progress 0.0 → 1.0):
 *   t 0.00–0.15  Upper-left square slides in from up-left while fading in
 *   t 0.10–0.25  Lower-right square slides in from down-right; the two meet
 *                corner-to-corner at screen centre — the ▚ resolves
 *   t 0.50–0.75  Wordmark "M I N T I" + rule fade in below
 *   t 0.60+      Progress bar pulses in mint green; messages appear below
 *
 * No image files: the mark is drawn with Rectangle primitives and the
 * wordmark with Image.Text, so the theme ships with zero rasterized assets.
 * Colors: cyan #5fd7ff (the mark), mint #00d787 (wordmark + bar, the single
 * focus accent), grey #8a8a8a, near-black bg #0a0a0a.
 */

// ── palette ────────────────────────────────────────────────────────────────
bgR = 0.039; bgG = 0.039; bgB = 0.039;        // #0a0a0a
cyanR = 0.373; cyanG = 0.843; cyanB = 1.0;    // #5fd7ff (bright cyan)
mintR = 0.0;  mintG = 0.843; mintB = 0.529;   // #00d787 (mint green)
greyR = 0.541; greyG = 0.541; greyB = 0.541;  // #8a8a8a

// ── layout ─────────────────────────────────────────────────────────────────
screenW = Window.GetWidth();
screenH = Window.GetHeight();
cx = screenW / 2;
cy = screenH / 2 - 60;   // the corner where the squares meet, above centre

side = 90;               // quadrant square side, px
slide = 26;              // approach distance during the fade-in

// ── background ─────────────────────────────────────────────────────────────
bg = Rectangle();
bg.SetX(0); bg.SetY(0);
bg.SetWidth(screenW); bg.SetHeight(screenH);
bg.SetColor(bgR, bgG, bgB, 1.0);
bg.SetZ(-10);

// ── the two quadrants (final corners meet at cx,cy) ────────────────────────
ul = Rectangle();
ul.SetWidth(side); ul.SetHeight(side);
ul.SetColor(cyanR, cyanG, cyanB, 1.0);
ul.SetX(cx - side); ul.SetY(cy - side);
ul.SetOpacity(0.0);

lr = Rectangle();
lr.SetWidth(side); lr.SetHeight(side);
lr.SetColor(cyanR, cyanG, cyanB, 1.0);
lr.SetX(cx); lr.SetY(cy);
lr.SetOpacity(0.0);

// ── wordmark + rule ─────────────────────────────────────────────────────────
wm = Image.Text("M I N T I", mintR, mintG, mintB, 1.0, "monospace 22");
wmSprite = Sprite(wm);
wmSprite.SetX(cx - wm.GetWidth() / 2);
wmY = cy + side + 40;
wmSprite.SetY(wmY);
wmSprite.SetOpacity(0.0);

ruleW = side * 2;
rule = Rectangle();
rule.SetX(cx - ruleW / 2);
rule.SetY(wmY + wm.GetHeight() + 14);
rule.SetWidth(ruleW); rule.SetHeight(2);
rule.SetColor(greyR, greyG, greyB, 1.0);
rule.SetOpacity(0.0);

// ── progress bar ────────────────────────────────────────────────────────────
barH = 3;
barW = side * 2;
barX = cx - barW / 2;
barY = wmY + wm.GetHeight() + 40;

barBg = Rectangle();
barBg.SetX(barX); barBg.SetY(barY);
barBg.SetWidth(barW); barBg.SetHeight(barH);
barBg.SetColor(0.1, 0.1, 0.1, 1.0);
barBg.SetOpacity(0.0);

barFg = Rectangle();
barFg.SetX(barX); barFg.SetY(barY);
barFg.SetWidth(0); barFg.SetHeight(barH);
barFg.SetColor(mintR, mintG, mintB, 1.0);
barFg.SetOpacity(0.0);

// ── message text ─────────────────────────────────────────────────────────────
msgSprite = Sprite();
msgSprite.SetOpacity(0.0);

// ── animation tick ───────────────────────────────────────────────────────────
fun refresh_callback() {
    t = Plymouth.GetBoot().GetProgress();

    // Phase 1: the quadrants approach and resolve (staggered)
    aUL = Math.Clamp((t * 2.4) / 0.35, 0.0, 1.0);
    aLR = Math.Clamp((t * 2.4 - 0.25) / 0.35, 0.0, 1.0);

    ul.SetOpacity(aUL);
    ul.SetX(cx - side - slide * (1 - aUL));
    ul.SetY(cy - side - slide * (1 - aUL));

    lr.SetOpacity(aLR);
    lr.SetX(cx + slide * (1 - aLR));
    lr.SetY(cy + slide * (1 - aLR));

    // Phase 2: wordmark + rule fade in
    wmA = Math.Clamp((t - 0.5) / 0.25, 0.0, 1.0);
    wmSprite.SetOpacity(wmA);
    rule.SetOpacity(wmA * 0.8);

    // Phase 3: progress bar
    barAlpha = Math.Clamp((t - 0.6) / 0.1, 0.0, 1.0);
    barBg.SetOpacity(barAlpha);
    barFg.SetOpacity(barAlpha);
    barFg.SetWidth(barW * t);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(msg) {
    // Render boot message below progress bar
    txt = Image.Text(msg, greyR, greyG, greyB, 1.0, "monospace 10");
    msgSprite.SetImage(txt);
    msgSprite.SetX(cx - txt.GetWidth() / 2);
    msgSprite.SetY(barY + barH + 12);
    msgSprite.SetOpacity(0.7);
}

Plymouth.SetMessageFunction(message_callback);
