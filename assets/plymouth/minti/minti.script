/* minti.script — Plymouth script-plugin boot animation.
 *
 * Animation sequence:
 *   0.0–0.6s  Background fades from black to #0a0a0a (instant, bg is already black)
 *   0.0–1.2s  9 nodes + 4 corner nodes fade in left-to-right, top-to-bottom
 *   1.2–1.8s  Edges draw in (opacity 0→1)
 *   1.8–2.4s  Wordmark "MINTI" fades in
 *   2.4s+     Progress bar pulses in mint green; message text appears below
 *
 * Colors: mint green #00d787, bright cyan #5fd7ff, near-black bg #0a0a0a
 * All coordinates are relative to screen center.
 */

// ── palette ────────────────────────────────────────────────────────────────
bgR = 0.039; bgG = 0.039; bgB = 0.039;       // #0a0a0a
nodeR = 0.373; nodeG = 0.843; nodeB = 1.0;    // #5fd7ff (bright cyan)
mintR = 0.0;  mintG = 0.843; mintB = 0.529;   // #00d787 (mint green)
greyR = 0.541; greyG = 0.541; greyB = 0.541;  // #8a8a8a

// ── layout ─────────────────────────────────────────────────────────────────
screenW = Window.GetWidth();
screenH = Window.GetHeight();
cx = screenW / 2;
cy = screenH / 2 - 60;   // logo sits slightly above center

// Node grid spacing
step = 70;  // px between grid nodes
// 3×3 grid columns: cx-step, cx, cx+step
// 3×3 grid rows:    cy-step, cy, cy+step

// ── background ─────────────────────────────────────────────────────────────
bg = Rectangle();
bg.SetX(0); bg.SetY(0);
bg.SetWidth(screenW); bg.SetHeight(screenH);
bg.SetColor(bgR, bgG, bgB, 1.0);
bg.SetZ(-10);

// ── nodes (13 total: 9 grid + 4 diagonal corners) ──────────────────────────
nodeR_px = 7;  // radius

fun MakeNode(x, y, delay) {
    n = Image("node.png");
    s = n.Scale(nodeR_px * 2, nodeR_px * 2);
    sprite = Sprite(s);
    sprite.SetX(x - nodeR_px);
    sprite.SetY(y - nodeR_px);
    sprite.SetOpacity(0.0);
    sprite.delay = delay;
    return sprite;
}

// Build node list with staggered delays (left→right, top→bottom)
nodeList = [];
row = 0;
for (row = 0; row < 3; row++) {
    col = 0;
    for (col = 0; col < 3; col++) {
        nx = cx + (col - 1) * step;
        ny = cy + (row - 1) * step;
        delay = (row * 3 + col) * 0.08;   // 80ms stagger
        nodeList[row * 3 + col] = MakeNode(nx, ny, delay);
    }
}
// Corner extensions (diagonal, ~0.7× step offset)
diag = step * 0.85;
corners = [
    MakeNode(cx - step - diag, cy - step - diag, 0.0),
    MakeNode(cx + step + diag, cy - step - diag, 0.08),
    MakeNode(cx - step - diag, cy + step + diag, 0.64),
    MakeNode(cx + step + diag, cy + step + diag, 0.72),
];

// ── logo image (wordmark PNG, exported from SVG) ────────────────────────────
logo = Image("minti-wordmark.png");
logoSprite = Sprite(logo);
logoSprite.SetX(cx - logo.GetWidth() / 2);
logoSprite.SetY(cy + step + 32);
logoSprite.SetOpacity(0.0);

// ── progress bar ────────────────────────────────────────────────────────────
barH = 3;
barW = step * 3;
barX = cx - barW / 2;
barY = cy + step + logo.GetHeight() + 52;

barBg = Rectangle();
barBg.SetX(barX); barBg.SetY(barY);
barBg.SetWidth(barW); barBg.SetHeight(barH);
barBg.SetColor(0.1, 0.1, 0.1, 1.0);
barBg.SetOpacity(0.0);

barFg = Rectangle();
barFg.SetX(barX); barFg.SetY(barY);
barFg.SetWidth(0); barFg.SetHeight(barH);
barFg.SetColor(mintR, mintG, mintB, 1.0);
barFg.SetOpacity(0.0);

// ── message text ─────────────────────────────────────────────────────────────
msgSprite = Sprite();
msgSprite.SetOpacity(0.0);

// ── animation tick ───────────────────────────────────────────────────────────
progress = 0.0;

fun refresh_callback() {
    t = Plymouth.GetBoot().GetProgress();
    progress = t;  // 0.0 → 1.0 over boot

    // Phase 1: nodes fade in (t 0.0–0.5)
    i = 0;
    for (i = 0; i < 9; i++) {
        n = nodeList[i];
        a = Math.Clamp((t * 2.4 - n.delay) / 0.3, 0.0, 1.0);
        n.SetOpacity(a);
    }
    for (i = 0; i < 4; i++) {
        n = corners[i];
        a = Math.Clamp((t * 2.4 - n.delay) / 0.3, 0.0, 1.0);
        n.SetOpacity(a);
    }

    // Phase 2: wordmark fades in (t 0.5–0.75)
    logoSprite.SetOpacity(Math.Clamp((t - 0.5) / 0.25, 0.0, 1.0));

    // Phase 3: progress bar appears (t 0.6+)
    barAlpha = Math.Clamp((t - 0.6) / 0.1, 0.0, 1.0);
    barBg.SetOpacity(barAlpha);
    barFg.SetOpacity(barAlpha);
    barFg.SetWidth(barW * t);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(msg) {
    // Render boot message below progress bar
    txt = Image.Text(msg, greyR, greyG, greyB, 1.0, "monospace 10");
    msgSprite.SetImage(txt);
    msgSprite.SetX(cx - txt.GetWidth() / 2);
    msgSprite.SetY(barY + barH + 12);
    msgSprite.SetOpacity(0.7);
}

Plymouth.SetMessageFunction(message_callback);
