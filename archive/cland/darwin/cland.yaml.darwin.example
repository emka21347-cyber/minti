# MINTI cland -- macOS defaults (LaunchDaemon system install).
#
# install-cland.sh drops this file at /Library/Application Support/MINTI/cland/cland.yaml
# on first system install (preserves any existing file on re-install). The
# per-user install rewrites the absolute paths to point under $HOME.
#
# The explicit `state.dir:` mirrors the Windows pattern -- gives a single
# source of truth for the daemon under _minti, where os.UserHomeDir()
# would return /var/empty.

listen:
  address: "0.0.0.0"
  port: 7777

state:
  # Holds clan.json, identity.json, audit.jsonl. install-cland.sh sets
  # chmod 0700 chown _minti:_minti on this directory.
  dir: "/Library/Application Support/MINTI/cland"

discovery:
  mdns_enabled: true
  rubric_path: "/Library/Application Support/MINTI/reasoning-scores.yaml"

# Election / advertise cadences left at spec defaults.

mcp:
  binaries_dir: "/usr/local/libexec/minti/mcp"

runtime:
  # cland talks to minti-runtime over loopback. On macOS the user
  # typically runs Ollama directly (downloaded from ollama.com) which
  # binds 127.0.0.1:11434, NOT minti-runtime (Linux-only build target
  # in v1). For now the macOS Clan member will report itself as
  # runtime-unhealthy unless the operator either:
  #   (a) builds + runs minti-runtime locally, or
  #   (b) sets MINTI_CLAND_FORCE_HEALTHY=1 in the plist
  #       EnvironmentVariables block (LaunchDaemon will pick it up on
  #       next launchctl bootstrap), or
  #   (c) accepts that this Mac is a worker-only member, never
  #       Orchestrator-eligible.
  base_url: "http://127.0.0.1:7780"

telemetry:
  log_level: "info"
