# MINTI cland — Clan daemon config (system defaults at /etc/minti/cland.yaml).
# Schema is documented at docs/clan-protocol.md §2 + §4. Edits take effect
# only on daemon restart.

listen:
  # The Clan-facing HTTPS listener. v1 is LAN-only; do NOT bind to a public
  # interface unless you've thought hard about it.
  address: "0.0.0.0"
  port: 7777

state:
  # Where cland persists Clan-level secrets (clan_key, pinned cert) and the
  # roster cache. Owned by the `minti` system user.
  dir: "/var/lib/minti/cland"

discovery:
  # mDNS registration + browsing. Disable on VLAN-hostile networks; falls
  # back to the manual `minti-cland peer-add <ip:port>` flow when off.
  mdns_enabled: true
  # Interface to bind mDNS to. Empty = all up + multicast-capable.
  interface: ""

election:
  # Leader-lease election cadence (spec §5.2). Defaults shown are the spec
  # values; override only with strong reason — peers MUST agree on these or
  # failover/quorum will misbehave.
  heartbeat_interval: 2s   # Orchestrator emits heartbeats this often.
  lease_duration:    8s    # Receiver-side lease window (lease_until = now + this).
  failover_grace:    6s    # Tolerated silence before peers begin election.
  election_timeout:  1s    # Wait window for accept-count to reach quorum.
  history_size:      32    # Ring buffer size for /clan/election/history.
  # R1 zombie-leader gate: Orchestrator stops heartbeating if its local
  # minti-runtime hasn't responded successfully within this window.
  runtime_probe_max_age: 60s

mcp:
  # Where MCP server binaries live (install.sh stages them here on Linux).
  # cland's /mcp/execute handler resolves "mcp-recon.nmap_scan" → spawning
  # "<binaries_dir>/minti-mcp-recon".
  binaries_dir: "/opt/minti/mcp"
  # Cap on (exp - approved_at) for a single execution token. Bounds replay
  # exposure across in-memory ReplayCache TTL gaps.
  max_token_lifetime: 10m
  # Cap on a single MCP CallTool invocation before cland kills the subprocess.
  exec_timeout: 5m

runtime:
  # Where this member's local minti-runtime listens. cland calls it over
  # 127.0.0.1 when serving reasoning/inference requests as Orchestrator.
  base_url: "http://127.0.0.1:7780"

telemetry:
  # debug | info | warn | error
  log_level: "info"
